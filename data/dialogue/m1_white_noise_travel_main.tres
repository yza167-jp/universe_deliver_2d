[gd_resource type="Resource" script_class="DialogueSequence" load_steps=7 format=3]

[ext_resource type="Script" path="res://scripts/narrative/dialogue_sequence.gd" id="1_sequence"]
[ext_resource type="Script" path="res://scripts/narrative/dialogue_line.gd" id="2_line"]
[ext_resource type="Script" path="res://scripts/narrative/dialogue_effect.gd" id="3_effect"]
[ext_resource type="Resource" path="res://data/characters/lao_pi.tres" id="4_lao_pi"]

[sub_resource type="Resource" id="EffectTravelCompleted"]
script = ExtResource("3_effect")
effect_id = &"story_m1_white_noise_cockpit_travel_completed"

[sub_resource type="Resource" id="LineRoute"]
script = ExtResource("2_line")
id = &"white_noise_route"
speaker = ExtResource("4_lao_pi")
text_key = &"DIALOGUE_M1_WHITE_NOISE_TRAVEL_MAIN_ROUTE"
portrait_expression = &"neutral"
next_line_id = &"white_noise_service"

[sub_resource type="Resource" id="LineService"]
script = ExtResource("2_line")
id = &"white_noise_service"
speaker = ExtResource("4_lao_pi")
text_key = &"DIALOGUE_M1_WHITE_NOISE_TRAVEL_MAIN_SERVICE"
portrait_expression = &"thoughtful"
next_line_id = &"white_noise_memory"

[sub_resource type="Resource" id="LineMemory"]
script = ExtResource("2_line")
id = &"white_noise_memory"
speaker = ExtResource("4_lao_pi")
text_key = &"DIALOGUE_M1_WHITE_NOISE_TRAVEL_MAIN_MEMORY"
portrait_expression = &"concerned"
effects = [SubResource("EffectTravelCompleted")]

[resource]
script = ExtResource("1_sequence")
id = &"dialogue_m1_white_noise_travel_main"
start_line_id = &"white_noise_route"
lines = [SubResource("LineRoute"), SubResource("LineService"), SubResource("LineMemory")]
