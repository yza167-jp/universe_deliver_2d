[gd_resource type="Resource" script_class="PlanetDefinition" load_steps=3 format=3]

[ext_resource type="Script" path="res://scripts/data/definitions/planet_definition.gd" id="1_planet"]
[ext_resource type="Resource" path="res://data/tuning/flight_environment_tidal_archipelago_placeholder.tres" id="2_environment"]

[resource]
script = ExtResource("1_planet")
id = &"planet_tidal_archipelago"
