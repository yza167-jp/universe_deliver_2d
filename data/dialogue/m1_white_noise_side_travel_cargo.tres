[gd_resource type="Resource" script_class="DialogueSequence" load_steps=5 format=3]

[ext_resource type="Script" path="res://scripts/narrative/dialogue_sequence.gd" id="1_sequence"]
[ext_resource type="Script" path="res://scripts/narrative/dialogue_line.gd" id="2_line"]
[ext_resource type="Resource" path="res://data/characters/lao_pi.tres" id="3_lao_pi"]

[sub_resource type="Resource" id="LineCase"]
script = ExtResource("2_line")
