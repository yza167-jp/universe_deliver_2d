cockpit_travel_phase_detail_keys = Array[StringName]([&"UI_M1_RED_SAND_REVISIT_COCKPIT_DETAIL_DEPARTURE", &"UI_M1_RED_SAND_REVISIT_COCKPIT_DETAIL_CRUISE", &"UI_M1_RED_SAND_REVISIT_COCKPIT_DETAIL_APPROACH", &"UI_M1_RED_SAND_REVISIT_COCKPIT_DETAIL_COMPLETED"])
