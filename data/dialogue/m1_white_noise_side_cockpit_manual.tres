[gd_resource type="Resource" script_class="DialogueSequence" load_steps=5 format=3]

[ext_resource type="Script" path="res://scripts/narrative/dialogue_sequence.gd" id="1_sequence"]
[ext_resource type="Script" path="res://scripts/narrative/dialogue_line.gd" id="2_line"]
[ext_resource type="Resource" path="res://data/characters/lao_pi.tres" id="3_lao_pi"]

[sub_resource type="Resource" id="LineVoluntary"]
script = ExtResource("2_line")
id = &"returned_memory_voluntary"
speaker = ExtResource("3_lao_pi")
text_key = &"DIALOGUE_M1_WHITE_NOISE_SIDE_COCKPIT_MANUAL_VOLUNTARY"
portrait_expression = &"thoughtful"
next_line_id = &"returned_memory_route"

[sub_resource type="Resource" id="LineRoute"]
script = ExtResource("2_line")
id = &"returned_memory_route"
speaker = ExtResource("3_lao_pi")
text_key = &"DIALOGUE_M1_WHITE_NOISE_SIDE_COCKPIT_MANUAL_ROUTE"
portrait_expression = &"neutral"

[resource]
script = ExtResource("1_sequence")
id = &"dialogue_m1_white_noise_side_cockpit_manual"
start_line_id = &"returned_memory_voluntary"
lines = [SubResource("LineVoluntary"), SubResource("LineRoute")]
