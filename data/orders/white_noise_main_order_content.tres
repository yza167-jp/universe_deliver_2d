[gd_resource type="Resource" script_class="WhiteNoiseMainOrderContent" load_steps=7 format=3]

[ext_resource type="Script" path="res://scripts/data/definitions/white_noise_main_order_content.gd" id="1_content"]
[ext_resource type="Resource" path="res://data/orders/m1_white_noise_archive_core.tres" id="2_order"]
[ext_resource type="Resource" path="res://data/dialogue/m1_white_noise_cockpit_manual.tres" id="3_manual"]
