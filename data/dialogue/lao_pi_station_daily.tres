[gd_resource type="Resource" script_class="DialogueSequence" load_steps=6 format=3]

[ext_resource type="Script" path="res://scripts/narrative/dialogue_sequence.gd" id="1_sequence"]
[ext_resource type="Script" path="res://scripts/narrative/dialogue_line.gd" id="2_line"]
[ext_resource type="Resource" path="res://data/characters/lao_pi.tres" id="3_lao_pi"]

[sub_resource type="Resource" id="LineDailyRest"]
script = ExtResource("2_line")
id = &"daily_rest"
speaker = ExtResource("3_lao_pi")
text_key = &"DIALOGUE_LAO_PI_DAILY_01"
portrait_expression = &"relaxed"
next_line_id = &"daily_presence"

[sub_resource type="Resource" id="LineDailyPresence"]
script = ExtResource("2_line")
id = &"daily_presence"
speaker = ExtResource("3_lao_pi")
text_key = &"DIALOGUE_LAO_PI_DAILY_02"
portrait_expression = &"friendly"

[resource]
script = ExtResource("1_sequence")
id = &"dialogue_lao_pi_station_daily"
start_line_id = &"daily_rest"
lines = [SubResource("LineDailyRest"), SubResource("LineDailyPresence")]
