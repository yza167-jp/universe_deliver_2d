effects = [SubResource("EffectChoiceRecorded"), SubResource("EffectMainCompleted")]

[resource]
script = ExtResource("1_sequence")
id = &"dialogue_m1_white_noise_arrival_main"
start_line_id = &"arrival_handoff"
lines = [SubResource("LineHandoff"), SubResource("LineDailyDetail"), SubResource("LineCompanyStance"), SubResource("LineOwnerConcern"), SubResource("LineRelayFragment"), SubResource("LineChoice"), SubResource("LineMinimumResponse"), SubResource("LineKeepResponse"), SubResource("LineCustodyResponse"), SubResource("LineSharedClose")]
