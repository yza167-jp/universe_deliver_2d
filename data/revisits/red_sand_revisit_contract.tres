flight_landing_rough_key = &"UI_M1_RED_SAND_REVISIT_FLIGHT_LANDING_ROUGH"
arrival_landing_smooth_key = &"UI_M1_RED_SAND_REVISIT_ARRIVAL_LANDING_SMOOTH"
arrival_landing_rough_key = &"UI_M1_RED_SAND_REVISIT_ARRIVAL_LANDING_ROUGH"
arrival_technician_prompt_key = &"UI_M1_RED_SAND_REVISIT_INTERACT_IYA"
