[gd_resource type="Resource" script_class="RedSandRevisitContract" load_steps=10 format=3]

[ext_resource type="Script" path="res://scripts/data/definitions/red_sand_revisit_contract.gd" id="1_contract"]
[ext_resource type="Resource" path="res://data/orders/m1_red_sand_shielding_retrofit.tres" id="2_order"]
[ext_resource type="Resource" path="res://data/dialogue/m1_red_sand_revisit_arrival.tres" id="3_dialogue"]
