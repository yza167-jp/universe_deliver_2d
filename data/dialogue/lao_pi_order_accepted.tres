[gd_resource type="Resource" script_class="DialogueSequence" load_steps=7 format=3]

[ext_resource type="Script" path="res://scripts/narrative/dialogue_sequence.gd" id="1_sequence"]
[ext_resource type="Script" path="res://scripts/narrative/dialogue_line.gd" id="2_line"]
[ext_resource type="Resource" path="res://data/characters/lao_pi.tres" id="3_lao_pi"]

[sub_resource type="Resource" id="LineAccepted"]
script = ExtResource("2_line")
id = &"accepted"
speaker = ExtResource("3_lao_pi")
text_key = &"DIALOGUE_LAO_PI_ORDER_ACCEPTED_01"
portrait_expression = &"neutral"
next_line_id = &"asteroid_note"

[sub_resource type="Resource" id="LineAsteroidNote"]
script = ExtResource("2_line")
id = &"asteroid_note"
speaker = ExtResource("3_lao_pi")
text_key = &"DIALOGUE_LAO_PI_ORDER_ACCEPTED_02"
portrait_expression = &"relaxed"
next_line_id = &"workbench_prompt"

[sub_resource type="Resource" id="LineWorkbenchPrompt"]
script = ExtResource("2_line")
id = &"workbench_prompt"
speaker = ExtResource("3_lao_pi")
text_key = &"DIALOGUE_LAO_PI_ORDER_ACCEPTED_03"
portrait_expression = &"friendly"

[resource]
script = ExtResource("1_sequence")
id = &"dialogue_lao_pi_order_accepted"
start_line_id = &"accepted"
lines = [SubResource("LineAccepted"), SubResource("LineAsteroidNote"), SubResource("LineWorkbenchPrompt")]
