[sub_resource type="Resource" id="ChoiceMinimumIndex"]
script = ExtResource("3_choice")
id = &"minimum_public_index"
text_key = &"DIALOGUE_M1_WHITE_NOISE_ARRIVAL_CHOICE_MINIMUM_INDEX"
