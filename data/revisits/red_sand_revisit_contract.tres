[ext_resource type="Resource" path="res://data/dialogue/m1_red_sand_revisit_optional.tres" id="5_optional"]
[ext_resource type="Resource" path="res://data/dialogue/m1_red_sand_revisit_cockpit_manual.tres" id="6_cockpit_manual"]
[ext_resource type="Resource" path="res://data/dialogue/m1_red_sand_revisit_travel_main.tres" id="7_travel_main"]
[ext_resource type="Resource" path="res://data/dialogue/m1_red_sand_revisit_travel_radio.tres" id="8_travel_radio"]
[ext_resource type="Resource" path="res://data/dialogue/m1_red_sand_revisit_travel_cargo.tres" id="9_travel_cargo"]

[resource]
script = ExtResource("1_contract")
id = &"red_sand_revisit_contract"
order = ExtResource("2_order")
arrival_dialogue = ExtResource("3_dialogue")
optional_dialogue = ExtResource("5_optional")
cockpit_manual_dialogue = ExtResource("6_cockpit_manual")
