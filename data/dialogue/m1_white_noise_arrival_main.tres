id = &"local_shared_custody"
text_key = &"DIALOGUE_M1_WHITE_NOISE_ARRIVAL_CHOICE_LOCAL_CUSTODY"
effects = [SubResource("EffectLocalCustody")]
next_line_id = &"arrival_local_custody_response"

[sub_resource type="Resource" id="LineHandoff"]
