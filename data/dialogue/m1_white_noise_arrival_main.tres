[gd_resource type="Resource" script_class="DialogueSequence" load_steps=26 format=3]

[ext_resource type="Script" path="res://scripts/narrative/dialogue_sequence.gd" id="1_sequence"]
[ext_resource type="Script" path="res://scripts/narrative/dialogue_line.gd" id="2_line"]
[ext_resource type="Script" path="res://scripts/narrative/dialogue_choice.gd" id="3_choice"]
[ext_resource type="Script" path="res://scripts/narrative/dialogue_effect.gd" id="4_effect"]
[ext_resource type="Script" path="res://scripts/data/definitions/character_definition.gd" id="5_character"]

[sub_resource type="Resource" id="SpeakerArchivist"]
script = ExtResource("5_character")
id = &"character_white_noise_archivist"
display_name_key = &"CHARACTER_WHITE_NOISE_ARCHIVIST_ROLE"
role_key = &"CHARACTER_WHITE_NOISE_ARCHIVIST_ROLE"

[sub_resource type="Resource" id="SpeakerMemoryOwner"]
script = ExtResource("5_character")
id = &"character_white_noise_memory_owner"
display_name_key = &"CHARACTER_WHITE_NOISE_MEMORY_OWNER_ROLE"
role_key = &"CHARACTER_WHITE_NOISE_MEMORY_OWNER_ROLE"

[sub_resource type="Resource" id="EffectMinimumIndex"]
