[gd_resource type="Resource" script_class="OrderDefinition" load_steps=13 format=3]

[ext_resource type="Script" path="res://scripts/data/definitions/order_definition.gd" id="1_order"]
[ext_resource type="Script" path="res://scripts/data/definitions/order_unlock_condition.gd" id="2_condition"]
[ext_resource type="Resource" path="res://data/characters/company_archive_service.tres" id="3_sender"]
[ext_resource type="Resource" path="res://data/characters/white_noise_archivist.tres" id="4_recipient"]
[ext_resource type="Resource" path="res://data/planets/white_noise.tres" id="5_planet"]
[ext_resource type="Resource" path="res://data/cargo/white_noise_archive_core.tres" id="6_cargo"]
[ext_resource type="Resource" path="res://data/modules/standard_drive.tres" id="7_drive"]
[ext_resource type="Resource" path="res://data/modules/high_voltage_shielding.tres" id="8_high_voltage"]
[ext_resource type="Resource" path="res://data/modules/shield_backup_power.tres" id="9_backup"]
[ext_resource type="Resource" path="res://data/modules/asteroid_laser.tres" id="10_laser"]

[sub_resource type="Resource" id="UnlockPlanet"]
script = ExtResource("2_condition")
condition_type = 0
reference_id = &"planet_white_noise"

[sub_resource type="Resource" id="UnlockModule"]
script = ExtResource("2_condition")
condition_type = 2
reference_id = &"module_high_voltage_shielding"

[resource]
script = ExtResource("1_order")
id = &"order_m1_white_noise_archive_core"
display_name_key = &"ORDER_M1_WHITE_NOISE_ARCHIVE_CORE_NAME_PROVISIONAL"
order_type = 0
content_readiness = 0
required_chapter = &"chapter_m1_white_noise"
unlock_conditions = [SubResource("UnlockPlanet"), SubResource("UnlockModule")]
sender = ExtResource("3_sender")
recipient = ExtResource("4_recipient")
destination_planet = ExtResource("5_planet")
planet_id = &"planet_white_noise"
destination_id = &"destination_white_noise_archive_platform"
cargo = ExtResource("6_cargo")
delivery_type = 0
credit_reward = 180
relation_rewards = {
&"planet_white_noise": 1
}
permission_rewards = Array[StringName]([&"permission_white_noise_archive_access"])
codex_rewards = Array[StringName]([&"codex_planet_white_noise", &"codex_character_white_noise_archivist", &"codex_cargo_white_noise_archive_core"])
souvenir_rewards = Array[StringName]([&"souvenir_white_noise_frost_index"])
repeat_policy = 0
route_distance = 1.25
risk_level = 4
required_modules = [ExtResource("7_drive"), ExtResource("8_high_voltage")]
recommended_modules = [ExtResource("9_backup"), ExtResource("10_laser")]
customer_history_keys = Array[StringName]([&"ORDER_M1_WHITE_NOISE_ARCHIVE_CORE_HISTORY_01", &"ORDER_M1_WHITE_NOISE_ARCHIVE_CORE_HISTORY_02", &"ORDER_M1_WHITE_NOISE_ARCHIVE_CORE_HISTORY_03"])
story_requirements = Array[StringName]([&"story_m1_red_sand_shielding_retrofit_completed"])
completion_flags = Array[StringName]([&"story_m1_white_noise_archive_core_completed"])
